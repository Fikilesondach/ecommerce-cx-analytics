   "source": [
    "\"\"\"\n",
    "01_eda.py\n",
    "---------\n",
    "Exploratory Data Analysis for ecommerce-cx-analytics.\n",
    "Run cell by cell in Jupyter, or convert to .ipynb with jupytext.\n",
    "\n",
    "Confirms four things before modelling:\n",
    "  1. November/December seasonal spikes are present\n",
    "  2. Year-over-year contact volume growth is visible\n",
    "  3. Channel mix is shifting (phone down, chat up)\n",
    "  4. CSAT degrades in high-volume months\n",
    "\n",
    "Usage:\n",
    "    jupyter notebook  →  open this file\n",
    "    OR: jupyter nbconvert --to notebook --execute 01_eda.py\n",
    "\"\"\"\n",
    "\n",
    "# =============================================================================\n",
    "# CELL 1 — Imports and data load\n",
    "# =============================================================================\n",
    "\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import matplotlib.ticker as mtick\n",
    "import warnings\n",
    "warnings.filterwarnings('ignore')\n",
    "\n",
    "# --- Load the four raw datasets ---\n",
    "contacts     = pd.read_csv('/Users/fikilesondach/Github Projects/ecommerce-cx-analytics/data/raw/contacts.csv', parse_dates=['month'])\n",
    "orders       = pd.read_csv('/Users/fikilesondach/Github Projects/ecommerce-cx-analytics/data/raw/orders.csv',   parse_dates=['month'])\n",
    "costs        = pd.read_csv('/Users/fikilesondach/Github Projects/ecommerce-cx-analytics/data/raw/costs.csv',    parse_dates=['month'])\n",
    "satisfaction = pd.read_csv('/Users/fikilesondach/Github Projects/ecommerce-cx-analytics/data/raw/satisfaction.csv', parse_dates=['month'])\n",
    "\n",
    "print(\"Shapes:\")\n",
    "print(f\"  contacts:     {contacts.shape}\")\n",
    "print(f\"  orders:       {orders.shape}\")\n",
    "print(f\"  costs:        {costs.shape}\")\n",
    "print(f\"  satisfaction: {satisfaction.shape}\")\n",
    "\n",
    "print(\"\\nContacts — first 5 rows:\")\n",
    "print(contacts.head())\n",
    "\n",
    "print(\"\\nMissing values:\")\n",
    "for name, df in [('contacts', contacts), ('orders', orders),\n",
    "                 ('costs', costs), ('satisfaction', satisfaction)]:\n",
    "    print(f\"  {name}: {df.isnull().sum().sum()} nulls\")\n",
    "\n",
    "\n",
    "# =============================================================================\n",
    "# CELL 2 — CHECK 1: Monthly contact volume by brand (seasonal spikes)\n",
    "# =============================================================================\n",
    "\n",
    "# Aggregate: total contacts per brand per month (sum across channels)\n",
    "brand_monthly = (\n",
    "    contacts\n",
    "    .groupby(['brand', 'month'])['contact_volume']\n",
    "    .sum()\n",
    "    .reset_index()\n",
    ")\n",
    "\n",
    "brands = contacts['brand'].unique()\n",
    "colors = {'Takealot': '#1f77b4', 'MrD': '#ff7f0e', 'Sellers': '#2ca02c', 'TFS': '#d62728'}\n",
    "\n",
    "fig, axes = plt.subplots(2, 2, figsize=(14, 8), sharey=False)\n",
    "axes = axes.flatten()\n",
    "\n",
    "for i, brand in enumerate(brands):\n",
    "    ax = axes[i]\n",
    "    data = brand_monthly[brand_monthly['brand'] == brand]\n",
    "    ax.plot(data['month'], data['contact_volume'],\n",
    "            color=colors[brand], linewidth=2, marker='o', markersize=4)\n",
    "\n",
    "    # Shade November (Black Friday)\n",
    "    for _, row in data[data['month'].dt.month == 11].iterrows():\n",
    "        ax.axvline(row['month'], color='orange', alpha=0.4, linewidth=8, label='Black Friday' if _ == data.index[0] else '')\n",
    "\n",
    "    ax.set_title(f'{brand}', fontsize=13, fontweight='bold')\n",
    "    ax.set_xlabel('')\n",
    "    ax.set_ylabel('Total Contacts')\n",
    "    ax.tick_params(axis='x', rotation=45)\n",
    "    ax.yaxis.set_major_formatter(mtick.FuncFormatter(lambda x, _: f'{x:,.0f}'))\n",
    "    ax.grid(axis='y', alpha=0.3)\n",
    "\n",
    "fig.suptitle('CHECK 1 — Monthly Contact Volume by Brand\\n(orange shading = Black Friday month)',\n",
    "             fontsize=14, fontweight='bold', y=1.01)\n",
    "plt.tight_layout()\n",
    "plt.savefig('/Users/fikilesondach/Github Projects/ecommerce-cx-analytics/outputs/figures/eda_01_contact_volume_by_brand.png', bbox_inches='tight', dpi=150)\n",
    "plt.show()\n",
    "print(\"Saved: eda_01_contact_volume_by_brand.png\")\n",
    "\n",
    "# What to look for:\n",
    "#   - Clear spikes in November and December every year\n",
    "#   - 2023 line sits higher than 2022 (YoY growth)\n",
    "#   - MrD highest absolute volume, Sellers lowest\n",
    "\n",
    "\n",
    "# =============================================================================\n",
    "# CELL 3 — CHECK 2: Year-over-year growth confirmation\n",
    "# =============================================================================\n",
    "\n",
    "# Compare total contacts: 2022 vs 2023\n",
    "contacts['year'] = contacts['month'].dt.year\n",
    "yoy = (\n",
    "    contacts\n",
    "    .groupby(['brand', 'year'])['contact_volume']\n",
    "    .sum()\n",
    "    .unstack('year')\n",
    "    .rename(columns={2022: 'Y2022', 2023: 'Y2023'})\n",
    ")\n",
    "yoy['growth_pct'] = ((yoy['Y2023'] - yoy['Y2022']) / yoy['Y2022'] * 100).round(1)\n",
    "\n",
    "print(\"Year-over-Year Contact Volume Growth:\")\n",
    "print(yoy.to_string())\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(9, 5))\n",
    "x = np.arange(len(yoy))\n",
    "width = 0.35\n",
    "\n",
    "bars1 = ax.bar(x - width/2, yoy['Y2022'], width, label='2022',\n",
    "               color=[colors[b] for b in yoy.index], alpha=0.6)\n",
    "bars2 = ax.bar(x + width/2, yoy['Y2023'], width, label='2023',\n",
    "               color=[colors[b] for b in yoy.index], alpha=1.0)\n",
    "\n",
